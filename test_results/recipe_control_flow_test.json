{
  "plan_id": "WFGY-SPLIT-MERGE-001",
  "intent_analysis": "Analyse des métadonnées d'un fichier source, division conditionnelle par statut, puis fusion des résultats.",
  "steps": [
    {
      "step": 1,
      "primitive": "io.metadata",
      "depends_on": [],
      "ui": {
        "label": "Lecture métadonnées source",
        "color": "#4A90E2",
        "position": {
          "x": 100,
          "y": 100
        }
      },
      "args": {
        "path": "users_source.csv"
      }
    },
    {
      "step": 2,
      "primitive": "core.condition",
      "depends_on": [
        1
      ],
      "ui": {
        "label": "Vérification existence et traitement",
        "color": "#E2904A",
        "position": {
          "x": 300,
          "y": 100
        }
      },
      "args": {
        "expression": "${FILE_EXISTS} == true",
        "then_steps": [
          {
            "step": 3,
            "primitive": "data.split",
            "depends_on": [
              1
            ],
            "ui": {
              "label": "Division par statut",
              "color": "#4AE290",
              "position": {
                "x": 500,
                "y": 50
              }
            },
            "args": {
              "source": "users_source.csv",
              "destination_prefix": "split_out",
              "by_column": "status"
            }
          },
          {
            "step": 4,
            "primitive": "data.merge",
            "depends_on": [
              3
            ],
            "ui": {
              "label": "Fusion des fichiers",
              "color": "#904AE2",
              "position": {
                "x": 700,
                "y": 50
              }
            },
            "args": {
              "sources": "split_out_active.csv,split_out_inactive.csv",
              "destination": "merged_final.csv"
            }
          }
        ]
      }
    }
  ]
}