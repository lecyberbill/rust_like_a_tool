{
  "plan_id": "WFGY-JOIN-GROUPBY-001",
  "intent_analysis": "Jointure de deux fichiers sources suivie d'une agrégation par statut pour générer un résumé financier.",
  "steps": [
    {
      "step": 1,
      "primitive": "data.join",
      "ui": {
        "label": "Jointure des données utilisateurs et transactions",
        "color": "#4A90E2",
        "position": {
          "x": 100,
          "y": 100
        }
      },
      "args": {
        "left_source": "users_input.csv",
        "right_source": "tx_input.json",
        "destination": "joined_output.csv",
        "left_on": "user_id",
        "right_on": "user_id",
        "how": "inner"
      }
    },
    {
      "step": 2,
      "primitive": "data.groupby",
      "ui": {
        "label": "Agrégation des montants par statut",
        "color": "#50E3C2",
        "position": {
          "x": 100,
          "y": 250
        }
      },
      "args": {
        "source": "joined_output.csv",
        "destination": "aggregated_summary.json",
        "groupby_columns": "status",
        "aggregate_column": "amount",
        "operation": "sum"
      }
    }
  ]
}