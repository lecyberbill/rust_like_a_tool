{
  "plan_id": "wfgy-plan-001",
  "intent_analysis": "Jointure de données utilisateurs et transactions suivie d'une agrégation par statut pour calculer le montant total.",
  "steps": [
    {
      "step": 1,
      "primitive": "data.join",
      "depends_on": [],
      "ui": {
        "label": "Jointure Users et Transactions",
        "color": "#4A90E2",
        "position": {
          "x": 100,
          "y": 100
        }
      },
      "args": {
        "left_source": "users_input.csv",
        "right_source": "tx_input.json",
        "destination": "joined_output.csv",
        "left_on": "user_id",
        "right_on": "user_id",
        "how": "inner"
      }
    },
    {
      "step": 2,
      "primitive": "data.groupby",
      "depends_on": [
        1
      ],
      "ui": {
        "label": "Agrégation par statut",
        "color": "#50E3C2",
        "position": {
          "x": 100,
          "y": 300
        }
      },
      "args": {
        "source": "joined_output.csv",
        "destination": "aggregated_summary.json",
        "groupby_columns": "status",
        "aggregate_column": "amount",
        "operation": "sum"
      }
    }
  ]
}