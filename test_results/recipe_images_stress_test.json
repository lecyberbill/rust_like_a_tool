{
  "plan_id": "plan_extract_images_20231005",
  "intent_analysis": "Extraction of all image URLs from Wikipedia homepage using regex and saving results to extracted_links.json",
  "steps": [
    {
      "step": 1,
      "primitive": "net.http_request",
      "depends_on": [],
      "args": {
        "url": "https://www.wikipedia.org/",
        "method": "GET",
        "extract_regex": "(?i)<img[^>]+src=\"([^\"]+)\"",
        "extract_destination": "extracted_links.json"
      }
    },
    {
      "step": 2,
      "primitive": "data.filter",
      "depends_on": [
        1
      ],
      "args": {
        "source": "extracted_links.json",
        "destination": "filtered_images.json",
        "column_index": -1,
        "operator": "contains",
        "value": "",
        "has_headers": false
      }
    }
  ]
}