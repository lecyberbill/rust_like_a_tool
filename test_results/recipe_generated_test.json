{
  "plan_id": "wfgy_plan_20231027_001",
  "intent_analysis": "Téléchargement et conversion d'un XML, suivi du filtrage, sauvegarde et nettoyage d'un fichier CSV d'utilisateurs.",
  "steps": [
    {
      "step": 1,
      "primitive": "net.download",
      "ui": {
        "label": "Téléchargement catalogue XML",
        "color": "#4A90E2",
        "position": {
          "x": 50,
          "y": 50
        }
      },
      "args": {
        "url": "https://www.w3schools.com/xml/simple.xml",
        "destination": "test_downloaded.xml"
      }
    },
    {
      "step": 2,
      "primitive": "io.metadata",
      "ui": {
        "label": "Lecture métadonnées XML",
        "color": "#4A90E2",
        "position": {
          "x": 250,
          "y": 50
        }
      },
      "args": {
        "path": "test_downloaded.xml"
      }
    },
    {
      "step": 3,
      "primitive": "data.xml_to_json",
      "ui": {
        "label": "Conversion XML vers JSON",
        "color": "#4A90E2",
        "position": {
          "x": 450,
          "y": 50
        }
      },
      "args": {
        "source": "test_downloaded.xml",
        "destination": "catalog_results.json"
      }
    },
    {
      "step": 4,
      "primitive": "data.filter",
      "ui": {
        "label": "Filtrage utilisateurs actifs",
        "color": "#E24A4A",
        "position": {
          "x": 50,
          "y": 200
        }
      },
      "args": {
        "source": "users_to_import.csv",
        "destination": "users_active.csv",
        "column_name": "status",
        "operator": "equals",
        "value": "active",
        "has_headers": true
      }
    },
    {
      "step": 5,
      "primitive": "io.copy",
      "ui": {
        "label": "Sauvegarde CSV filtré",
        "color": "#E24A4A",
        "position": {
          "x": 250,
          "y": 200
        }
      },
      "args": {
        "source": "users_active.csv",
        "destination": "backup_users.csv"
      }
    },
    {
      "step": 6,
      "primitive": "io.delete",
      "ui": {
        "label": "Suppression sécurisée CSV",
        "color": "#E24A4A",
        "position": {
          "x": 450,
          "y": 200
        }
      },
      "args": {
        "path": "users_active.csv",
        "secure": "trash",
        "retention_days": 1
      }
    }
  ]
}