# =============================================================================
# WFGY-Core V3 — Variables d'environnement
# =============================================================================
# Copier ce fichier en .env et adapter les valeurs
# Ne JAMAIS committer le .env avec des secrets reels
# =============================================================================

# Port du serveur WebSocket (par defaut 8765)
PORT=8765

# Port du serveur HTTP (par defaut 8766)
HTTP_PORT=8766

# Environnement (dev, test, prod)
WFGY_ENV=dev

# Niveau de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
WFGY_LOG_LEVEL=INFO

# ── Vault secrets ──────────────────────────────────────────────
# Cle de chiffrement du vault Chromatix (OBLIGATOIRE)
# Generer une cle forte: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_VAULT_KEY=change_me_in_production

# Chemin vers le module Chromatix (optionnel si dans le repertoire parent)
# CHROMATIX_PATH=../chromatix

# ── Authentification JWT ───────────────────────────────────────
# Secret JWT pour les tokens d'authentification (OBLIGATOIRE)
# Generer: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_in_production

# Duree de validite des tokens JWT en secondes (defaut: 24h)
JWT_TTL=86400

# ── LLM / IA ───────────────────────────────────────────────────
# Fournisseur LLM: openai_compatible, gemini
LLM_PROVIDER=openai_compatible

# Modele cible
LLM_MODEL=gemma

# URL de base pour le serveur local (LM Studio, Ollama)
LLM_BASE_URL=http://localhost:1234/v1

# Cle API pour le fournisseur LLM (Gemini, OpenAI)
LLM_API_KEY=

# ── Bases de donnees (optionnel) ──────────────────────────────
# PostgreSQL
# PG_TEST_DSN=postgresql://user:pass@localhost:5432/postgres

# MongoDB
# SECRET_MONGO_URI=mongodb://localhost:27017

# ── Binaire Rust (optionnel) ──────────────────────────────────
# Chemin personnalise vers le binaire rust_muscle
# RUST_BIN_PATH=./rust_muscle/target/release/rust_muscle.exe

# ── SSL (optionnel) ───────────────────────────────────────────
# SSL_CERT=./certs/cert.pem
# SSL_KEY=./certs/key.pem
