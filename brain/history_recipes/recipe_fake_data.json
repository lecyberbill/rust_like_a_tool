{
  "plan_id": "scenario_fake_data",
  "intent_analysis": "Génération de données factices → nettoyage → filtre des mineurs → insertion PostgreSQL",
  "steps": [
    {
      "step": 1,
      "primitive": "data.generate_fake",
      "depends_on": [],
      "ui": {
        "label": "Générer 100 profils factices",
        "color": "#4A90E2",
        "position": { "x": 44, "y": 99 }
      },
      "args": {
        "columns": "id:id,prenom:first_name,nom:last_name,email:email,cotisation_a_jour:boolean,adresse:address,cp:postal_code,date_naissance:date",
        "count": "100",
        "format": "csv"
      }
    },
    {
      "step": 2,
      "primitive": "data.clean",
      "depends_on": [1],
      "ui": {
        "label": "Nettoyage & Calcul Majorité",
        "color": "#7EB8E0",
        "position": { "x": 300, "y": 99 }
      },
      "args": {
        "source": "",
        "destination": "workspace/output/fake_data_clean.csv",
        "select_columns": "id,prenom,nom,email,cotisation_a_jour,adresse,cp,date_naissance,majeur",
        "derive_columns": "majeur=IF date_naissance <= '2008-06-17' THEN 'true' ELSE 'false'",
        "rename_columns": "",
        "fill_na": ""
      }
    },
    {
      "step": 3,
      "primitive": "data.filter",
      "depends_on": [2],
      "ui": {
        "label": "Filtrer les Mineurs",
        "color": "#F5A623",
        "position": { "x": 560, "y": 99 }
      },
      "args": {
        "source": "",
        "destination": "workspace/output/minors.csv",
        "column_name": "majeur",
        "operator": "equals",
        "value": "false",
        "has_headers": true
      }
    },
    {
      "step": 4,
      "primitive": "db.insert",
      "depends_on": [3],
      "ui": {
        "label": "Insert PostgreSQL (localhost)",
        "color": "#7ED321",
        "position": { "x": 820, "y": 99 }
      },
      "args": {
        "connection_string": "${SECRET_POSTGRES_CONNECTION_STRING}",
        "table_name": "mineurs",
        "source": "",
        "mode": "replace"
      }
    }
  ],
  "env": {
    "dev": {
      "SECRET_MYSQL_USER": "user_dev",
      "SECRET_MYSQL_PASSWORD": "user_dev",
      "SECRET_POSTGRES_CONNECTION_STRING": "postgresql://user_dev:user_dev@localhost:5432/postgres"
    },
    "test": {},
    "prod": {}
  }
}
