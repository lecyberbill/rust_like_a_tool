{
  "plan_id": "wfgy_core_v3_step_20231015",
  "intent_analysis": "Télécharge, analyse et transforme les données XML et CSV selon les spécifications.",
  "steps": [
    {
      "step": 1,
      "primitive": "net.download",
      "depends_on": [],
      "args": {
        "url": "https://www.w3schools.com/xml/simple.xml",
        "destination": "test_downloaded.xml"
      }
    },
    {
      "step": 2,
      "primitive": "io.metadata",
      "depends_on": [
        1
      ],
      "args": {
        "path": "test_downloaded.xml"
      }
    },
    {
      "step": 3,
      "primitive": "data.json_to_csv",
      "depends_on": [
        2
      ],
      "args": {
        "source": "catalog_results.json",
        "destination": "catalog_results.csv",
        "delimiter": ",",
        "has_headers": true
      }
    },
    {
      "step": 4,
      "primitive": "data.filter",
      "depends_on": [
        3
      ],
      "args": {
        "source": "users_to_import.csv",
        "destination": "users_active.csv",
        "delimiter": ",",
        "column_index": 2,
        "column_name": "status",
        "operator": "equals",
        "value": "active",
        "has_headers": true
      }
    },
    {
      "step": 5,
      "primitive": "io.copy",
      "depends_on": [
        4
      ],
      "args": {
        "source": "users_active.csv",
        "destination": "backup_users.csv",
        "mode": "binary",
        "conflict": "overwrite"
      }
    },
    {
      "step": 6,
      "primitive": "s3.upload",
      "depends_on": [
        5
      ],
      "args": {
        "bucket": "${S3_BUCKET}",
        "file_path": "backup_users.csv",
        "object_key": "users_backup.csv",
        "aws_access_key_id": "${AWS_ACCESS_KEY_ID}",
        "aws_secret_access_key": "${AWS_SECRET_ACCESS_KEY}"
      }
    },
    {
      "step": 7,
      "primitive": "io.remove",
      "depends_on": [
        6
      ],
      "args": {
        "path": "backup_users.csv",
        "retention_days": 1,
        "secure": "trash"
      }
    }
  ]
}