{
  "plan_id": "WFGY-CORE-V3-CATALOG-USER-PROC",
  "intent_analysis": "Téléchargement et conversion d'un catalogue XML, suivi du filtrage, sauvegarde et nettoyage d'un fichier CSV d'utilisateurs.",
  "steps": [
    {
      "step": 1,
      "primitive": "net.download",
      "depends_on": [],
      "ui": {
        "label": "Téléchargement catalogue",
        "color": "#4A90E2",
        "position": {
          "x": 50,
          "y": 50
        }
      },
      "args": {
        "url": "https://www.w3schools.com/xml/simple.xml",
        "destination": "test_downloaded.xml"
      }
    },
    {
      "step": 2,
      "primitive": "io.metadata",
      "depends_on": [
        1
      ],
      "ui": {
        "label": "Lecture métadonnées",
        "color": "#50E3C2",
        "position": {
          "x": 250,
          "y": 50
        }
      },
      "args": {
        "path": "test_downloaded.xml"
      }
    },
    {
      "step": 3,
      "primitive": "data.xml_to_json",
      "depends_on": [
        2
      ],
      "ui": {
        "label": "Conversion XML vers JSON",
        "color": "#F5A623",
        "position": {
          "x": 450,
          "y": 50
        }
      },
      "args": {
        "source": "test_downloaded.xml",
        "destination": "catalog_results.json"
      }
    },
    {
      "step": 4,
      "primitive": "data.filter",
      "depends_on": [],
      "ui": {
        "label": "Filtrage utilisateurs actifs",
        "color": "#D0021B",
        "position": {
          "x": 50,
          "y": 250
        }
      },
      "args": {
        "source": "users_to_import.csv",
        "destination": "users_active.csv",
        "column_name": "status",
        "operator": "equals",
        "value": "active",
        "has_headers": true
      }
    },
    {
      "step": 5,
      "primitive": "io.copy",
      "depends_on": [
        4
      ],
      "ui": {
        "label": "Sauvegarde CSV",
        "color": "#7ED321",
        "position": {
          "x": 250,
          "y": 250
        }
      },
      "args": {
        "source": "users_active.csv",
        "destination": "backup_users.csv",
        "mode": "text"
      }
    },
    {
      "step": 6,
      "primitive": "io.delete",
      "depends_on": [
        5
      ],
      "ui": {
        "label": "Suppression sécurisée",
        "color": "#9B9B9B",
        "position": {
          "x": 450,
          "y": 250
        }
      },
      "args": {
        "path": "users_active.csv",
        "secure": "trash",
        "retention_days": 1
      }
    }
  ]
}